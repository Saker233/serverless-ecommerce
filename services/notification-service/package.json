{
  "name": "@serverless-ecommerce/notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "SQS notification consumer for the serverless e-commerce platform",
  "main": "dist/handler.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "bash scripts/package-lambda.sh"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "dotenv": "^18.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
